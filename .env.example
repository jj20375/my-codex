# 複製後必須自行設定秘密；建議由 scripts/configure.mjs 自動產生。
WEB_PORT=4327
WEB_ORIGIN=http://localhost:4327
# 開發時連到既有 MariaDB；Docker 透過 host-gateway 連主機。
DB_HOST=127.0.0.1
DOCKER_DB_HOST=host.docker.internal
DB_PORT=9529
DB_NAME=codex_workspace
DB_USER=codex_workspace
DB_PASSWORD=
DB_ROOT_PASSWORD=
ADMIN_PASSWORD=
SESSION_SECRET=
RUNNER_SECRET=
LOCAL_FILES_SECRET=
# 主機服務由 node scripts/start-local-files.mjs 啟動。
LOCAL_FILES_URL=http://127.0.0.1:3042
RUNNER_URL=http://127.0.0.1:3041
API_HOST=127.0.0.1
API_PORT=3001
COOKIE_SECURE=false
DATA_DIR=../../.runtime/api
UPLOAD_DIR=../../.runtime/uploads
WORKSPACE_DIR=../../.runtime/workspaces
CODEX_STATE_DIR=../../.runtime/codex
# 開發時可設定系統 codex 的絕對路徑；Docker 由映像內建。
CODEX_BIN=
